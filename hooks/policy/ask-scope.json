{
  "enabled": true,
  "mode": "ask",
  "message": "Ask-scope: path outside prompt allow-set. Confirm drive-by or narrow the ask.",
  "path_token_pattern": "(?:^|[\\s`\"'(])([A-Za-z0-9_./-]+\\.[A-Za-z0-9]+)(?:$|[\\s`\"')])",
  "exempt_prefixes": [
    "hooks/policy/",
    "hooks/bin/",
    "hooks/kleos-gate/",
    ".cursor/breakthrough-chain.md",
    "docs/evals/",
    "docs/RELEASE.md",
    "package.json",
    "user-rules/",
    "project-rules/"
  ],
  "min_tokens": 1
}
