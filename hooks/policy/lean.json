{
  "enabled_env": "KLEOS_LEAN",
  "enabled_default": true,
  "new_file_loc_env": "KLEOS_LEAN_NEW_FILE_LOC",
  "new_file_loc": 120,
  "net_delta_env": "KLEOS_LEAN_NET_DELTA",
  "net_delta": 200,
  "file_loc_max_env": "KLEOS_LEAN_FILE_LOC_MAX",
  "file_loc_max": 700,
  "code_extensions": [
    ".py", ".pyi", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts",
    ".rs", ".go", ".java", ".kt", ".kts", ".swift", ".rb", ".php", ".c", ".cc",
    ".cpp", ".cxx", ".h", ".hpp", ".cs", ".scala", ".sh", ".bash", ".zsh",
    ".ps1", ".sql", ".r", ".lua", ".vim", ".el", ".ex", ".exs", ".erl", ".hs",
    ".ml", ".mli", ".zig", ".nim", ".dart", ".vue", ".svelte",
    ".css", ".scss", ".sass", ".less", ".html", ".htm"
  ],
  "enforce_always": true
}
