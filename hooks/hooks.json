{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 ./hooks/block-secrets.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 ./hooks/gate-shell.py",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 ./hooks/gate-write.py",
        "failClosed": true
      },
      {
        "command": "python3 ./hooks/gate-delete.py",
        "matcher": "Delete",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python3 ./hooks/session-ledger.py",
        "failClosed": false
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 ./hooks/gate-fail.py",
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 ./hooks/gate-read.py",
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "python3 ./hooks/gate-read.py",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 ./hooks/gate-mcp.py",
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "python3 ./hooks/gate-subagent.py",
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "python3 ./hooks/gate-subagent.py",
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": "python3 ./hooks/session-boundary.py",
        "failClosed": false
      }
    ],
    "preCompact": [
      {
        "command": "python3 ./hooks/session-boundary.py",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "python3 ./hooks/stop-verify.py",
        "loop_limit": 1,
        "failClosed": false
      }
    ]
  }
}
